#!/usr/bin/env node

import { App } from '../app.js'; // Ensure you're importing App
import debugLib from 'debug';
import http from 'http';
import dotenv from 'dotenv';

const debug = debugLib('int-service:server');

dotenv.config({ path: '.env' });

if (!process.env.PORT) {
  console.error('PORT environment variable is not set');
  process.exit(1);
}

const port = normalizePort(process.env.PORT || '3000');

const app = await App(); // <-- Now call the App function to get the app instance
app.set('port', port);

const server = http.createServer(app);

// Event listeners for error and listening
server.listen(port);
server.on('error', onError);
server.on('listening', onListening);

// Normalize port helper function
function normalizePort(val) {
  const parsedPort = parseInt(val, 10);
  if (isNaN(parsedPort)) {
    return val; // Named pipe
  }
  if (parsedPort >= 0) {
    return parsedPort; // Port number
  }
  return false;
}

// Error handling function
function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  const bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;

  switch (error.code) {
    case 'EACCES':
      console.error(`${bind} requires elevated privileges`);
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(`${bind} is already in use`);
      process.exit(1);
      break;
    default:
      throw error;
  }
}

// Listening to event listener
function onListening() {
  const addr = server.address();
  const bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug(`Listening on ${bind}`);
}

// Shutdown signals
process.on('SIGINT', () => {
  console.log('SIGINT signal received: closing HTTP server');
  server.close(() => {
    console.log('HTTP server closed');
    process.exit(0);
  });
});

process.on('SIGTERM', () => {
  console.log('SIGTERM signal received: closing HTTP server');
  server.close(() => {
    console.log('HTTP server closed');
    process.exit(0);
  });
});